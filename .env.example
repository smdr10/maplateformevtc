# Copier en .env et remplir. Ne jamais commiter le vrai .env.

DATABASE_URL=postgresql://user:password@host:5432/db
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=15m

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RESEND_API_KEY=

# Tache quotidienne /api/cron/expire-listings (en-tete Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Stripe (mode test : sk_test_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
# Optionnel : taux de TVA 20 % "inclus" cree dans Stripe (txr_...)
STRIPE_TAX_RATE_ID=

# URL publique du site (retours Stripe)
APP_URL=http://localhost:3000
